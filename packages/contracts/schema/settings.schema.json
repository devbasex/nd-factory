{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prefix": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]{1,18}[a-z0-9]$"
        },
        {
          "pattern": "^(?!aws)"
        }
      ]
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9]{2,10}$"
    },
    "login": {
      "type": "object",
      "properties": {
        "google": {
          "type": "object",
          "properties": {
            "client_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "google"
      ],
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "notify_emails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        }
      },
      "required": [
        "repository",
        "branch"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "prefix",
    "environment",
    "login"
  ],
  "additionalProperties": false
}
