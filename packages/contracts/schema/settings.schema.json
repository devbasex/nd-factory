{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "prefix": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]{1,18}[a-z0-9]$"
        },
        {
          "pattern": "^(?!aws)"
        }
      ]
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9]{2,10}$"
    },
    "login": {
      "type": "object",
      "properties": {
        "google": {
          "type": "object",
          "properties": {
            "client_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "google"
      ],
      "additionalProperties": false
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "notify_emails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        }
      },
      "required": [
        "repository",
        "branch"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "vpc_cidr": {
          "type": "string",
          "pattern": "^(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:(?:0)\\.0\\/16|(?:0|128)\\.0\\/17|(?:0|64|128|192)\\.0\\/18|(?:0|32|64|96|128|160|192|224)\\.0\\/19|(?:0|16|32|48|64|80|96|112|128|144|160|176|192|208|224|240)\\.0\\/20)$"
        }
      },
      "additionalProperties": false
    },
    "progress_db": {
      "type": "object",
      "properties": {
        "max_acu": {
          "type": "number",
          "minimum": 1,
          "maximum": 16,
          "multipleOf": 0.5
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "monthly_usd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "scope": {
          "type": "string",
          "enum": [
            "tags",
            "account"
          ]
        }
      },
      "additionalProperties": false
    },
    "ops": {
      "type": "object",
      "properties": {
        "notify_emails": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "prefix",
    "environment",
    "login"
  ],
  "additionalProperties": false
}
