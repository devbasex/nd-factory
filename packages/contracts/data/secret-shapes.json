{
  "key_names": ["authorization", "token", "secret", "password", "credentials", "private_key", "dsn"],
  "value_patterns": [
    { "name": "delegation_token", "pattern": "ndfd_[A-Za-z0-9_.-]+" },
    { "name": "machine_token", "pattern": "ndfm_[A-Za-z0-9_.-]+" },
    { "name": "jwt", "pattern": "eyJ[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+" },
    { "name": "github_app_token", "pattern": "ghs_[A-Za-z0-9]+" },
    { "name": "github_personal_token", "pattern": "ghp_[A-Za-z0-9]+" },
    { "name": "github_oauth_token", "pattern": "gho_[A-Za-z0-9]+" },
    { "name": "github_fine_grained_token", "pattern": "github_pat_[A-Za-z0-9_]+" },
    { "name": "private_key", "pattern": "-----BEGIN .*PRIVATE KEY-----" },
    { "name": "url_with_credentials", "pattern": "://[^/:]+:[^@]+@" },
    { "name": "aws_temporary_key", "pattern": "ASIA[0-9A-Z]{16}" }
  ]
}
