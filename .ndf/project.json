  "test": {
    "strategy": "local-full",
    "suites": [
      {
        "name": "vitest",
        "runner": "vitest",
        "command": "npm run test",
        "scope_command": "npx vitest run {paths}",
        "needs": [],
        "paths": [
          "packages",
          "apps",
          "infra",
          "tools",
          "vitest.config.ts",
          "package.json",
          "package-lock.json"
        ],
        "ci_jobs": [
          ".github/workflows/ci.yml#check"
        ]
      },
      {
        "name": "eslint",
        "runner": "eslint",
        "kind": "lint",
        "command": "npm run lint",
        "scope_command": "npx eslint {paths}",
        "needs": [],
        "paths": [
          "*.ts",
          "*.js",
          "*.cjs",
          "*.mjs"
        ],
        "ci_jobs": [
          ".github/workflows/ci.yml#check"
        ]
      },
      {
        "name": "typecheck",
        "runner": "tsc",
        "kind": "lint",
        "command": "npm run typecheck",
        "needs": [],
        "paths": [
          "*.ts",
          "tsconfig.base.json",
          "package.json"
        ],
        "ci_jobs": [
          ".github/workflows/ci.yml#check"
        ]
      },
      {
        "name": "contracts-generated",
        "runner": "node",
        "kind": "lint",
        "command": "npm run generate:check",
        "needs": [],
        "paths": [
          "packages/contracts"
        ],
        "ci_jobs": [
          ".github/workflows/ci.yml#check"
        ]
      },
      {
        "name": "web-e2e",
        "runner": "playwright",
        "command": "npx playwright install chromium && npm run e2e",
        "needs": [],
        "paths": [
          "apps/web",
          "packages/contracts"
        ],
        "ci_jobs": [
          ".github/workflows/ci.yml#e2e"
        ]
      }
    ],
    "ci": {
      "only": true
    }
  },
  "ci": {
    "provider": "github-actions",
    "workflows": [
      {
        "path": ".github/workflows/ci.yml",
        "jobs": 6
      },
      {
        "path": ".github/workflows/ndf-contract.yml",
        "jobs": 1
      }
