{
  "version": 1,
  "format": "json",
  "source": "docs/glossary/glossary.json",
  "document": "docs/glossary.md",
  "check": {
    "paths": [
      "issues/*-requirements.md",
      "issues/*-design.md",
      "issues/*-design-decisions.md",
      "issues/*-design-detail.md",
      "docs/design/overview.md",
      "docs/design/decisions.md",
      "docs/design/detail.md"
    ],
    "term_sections": [
      "用語"
    ],
    "banned": {
      "words": [
        "区切りの鍵",
        "並びの鍵",
        "冪等の鍵",
        "疎な索引",
        "強い整合",
        "月の使った量",
        "月の上限額",
        "状態の S3",
        "引き換えの token",
        "形の正本",
        "形の版",
        "条件つきの書き込み",
        "条件つきの更新",
        "照らす",
        "確かめ",
        "会話の控え",
        "端末の控え",
        "空を許すか",
        "知らせ",
        "断る"
      ],
      "paths": [
        "docs/design/**/*.md",
        "docs/glossary/*.md",
        "issues/*.md"
      ],
      "exclude": [
        "docs/design-process/**",
        "docs/design/mock/project/**"
      ]
    }
  }
}
